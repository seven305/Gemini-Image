{
  "Batch": {
    "DefaultConcurrency": 5,
    "OutputFolder": "output",
    "MaxRetriesPerJob": 3,
    "RetryBaseDelaySeconds": 2,
    "AccountFailureThreshold": 3,
    "GenerationTimeoutSeconds": 180,
    "MinInterPromptDelayMs": 300,
    "MaxInterPromptDelayMs": 800,
    "StartupStaggerMs": 4000,
    "MaxSessionRestarts": 1,
    "StripMetadata": true,
    "Headful": true,
    "UseFakeSession": false
  },
  "Gemini": {
    "Channel": "chrome",
    "DownloadMode": "Net",
    "DiagnosticsFolder": "diagnostics",
    "NavigationTimeoutSeconds": 60,
    "ActionTimeoutSeconds": 30,
    "PostResponseImageWaitSeconds": 20,
    "CdnCaptureWaitSeconds": 15,
    "WindowSize": "1280,900",
    "ProxyCheckUrl": null,
    "MaxConcurrentSignIns": 0
  },
  "Fake": {
    "FailureRate": 0.0,
    "MinDelayMs": 500,
    "MaxDelayMs": 1500,
    "AlwaysFailAccountIds": [],
    "ReadyFailAccountIds": [],
    "UnavailableAccountIds": [],
    "SessionLostAccountIds": [],
    "AccountLossAfterCalls": 2,
    "DailyLimitAfterImages": 5
  },
  "Logging": {
    "Folder": "logs"
  }
}
