    "MinDelayMs": 500,
    "MaxDelayMs": 1500,
    "AlwaysFailAccountIds": [],
    "ReadyFailAccountIds": []
  },
  "Accounts": {
    "Path": "accounts.json"
  },
  "Logging": {
    "Folder": "logs"
  }
}
