    "AccountFailureThreshold": 3,
    "GenerationTimeoutSeconds": 180,
    "MinInterPromptDelayMs": 300,
    "MaxInterPromptDelayMs": 800,
    "StripMetadata": true,
    "Headful": true
  },
  "Fake": {
